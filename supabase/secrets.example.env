# Supabase Edge Function secrets
# Set in Dashboard → Edge Functions → Secrets, or via CLI:
#   npx supabase secrets set --env-file supabase/secrets.env
#
# Do not commit a filled secrets.env file.

# --- Payment (iyzico) ---
# 1) https://merchant.iyzipay.com → Sandbox hesap aç
# 2) API Key + Secret Key kopyala
# 3) Aşağıyı doldur, PAYMENT_DEMO_MODE=false yap
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_SANDBOX=true
IYZICO_CALLBACK_BASE_URL=https://pehemxfydtwgpcasftyq.supabase.co/functions/v1/payment-callback
APP_URL=https://www.ride-yo.com
PLATFORM_COMMISSION_RATE=0.15
# true = demo payments without iyzico; false = require real iyzico keys
PAYMENT_DEMO_MODE=true

# --- SMS (Netgsm) ---
# 1) https://www.netgsm.com.tr → üyelik + SMS başlığı onayı
# 2) Aşağıyı doldur, SMS_PROVIDER=netgsm yap
# 3) Deploy: npx supabase secrets set SMS_PROVIDER=netgsm NETGSM_USERCODE=... NETGSM_PASSWORD=... NETGSM_MSGHEADER=...
SMS_PROVIDER=demo
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=

# --- Optional (AI chat / support) ---
LOVABLE_API_KEY=

# --- Verification email (edge function resend-verification) ---
# Get free key at https://resend.com — then:
#   npx supabase secrets set RESEND_API_KEY=re_xxx RESEND_FROM="RideYo <onboarding@resend.dev>" APP_URL=https://www.ride-yo.com
RESEND_API_KEY=
RESEND_FROM=RideYo <onboarding@resend.dev>

# --- License / identity (verify-license) ---
# NVİ / KPS TCKimlikNoDogrula. Public SOAP was restricted after 2025;
# set NVI_ENDPOINT to your institutional KPS URL when approved.
NVI_ENABLED=true
# NVI_ENDPOINT=https://your-institutional-kps-host/...
# If SOAP is unreachable, soft-fail keeps NFC+consent flow working (default true).
NVI_SOFT_FAIL=true

# --- Phone OTP / overtime (optional) ---
# PHONE_OTP_SECRET=
# OVERTIME_RATE_PER_MINUTE=7.5
# KM_PRICE_PER_UNIT=26.5

# --- Deploy CLI (local machine / CI, not edge secrets) ---
# SUPABASE_ACCESS_TOKEN=sbp_...
